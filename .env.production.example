APP_NAME=Sheltrify
APP_ENV=production
APP_KEY=                        # Run: php artisan key:generate
APP_DEBUG=false
APP_TIMEZONE=Africa/Lagos
APP_URL=https://yourdomain.com  # e.g. https://sheltrify.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error                 # Only log errors in production

# ── Database (MySQL on cPanel) ──────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpanelusername_sheltrify   # cPanel DB name: username_dbname
DB_USERNAME=cpanelusername_dbuser      # cPanel DB user
DB_PASSWORD=

# ── Sessions / Cache / Queue ────────────────────────────────────────────
SESSION_DRIVER=file              # Use 'file' on shared hosting (no Redis)
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.yourdomain.com  # e.g. .sheltrify.com (with leading dot)

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync            # Use 'sync' if no queue worker is running

CACHE_STORE=file                 # Use 'file' on shared hosting (no Redis)
CACHE_PREFIX=sheltrify_

# ── Mail (SMTP) ─────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=ssl
MAIL_HOST=mail.sheltrify.com
MAIL_PORT=465
MAIL_USERNAME=noreply@sheltrify.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@sheltrify.com"
MAIL_FROM_NAME="Sheltrify"

# ── AI / Gemini ─────────────────────────────────────────────────────────
GEMINI_API_KEY=                  # Your Google Gemini API key

# ── Paystack ────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_PAYMENT_URL=https://api.paystack.co

# ── Vite (frontend) ─────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
VITE_API_URL=                    # Leave empty — API is same-origin

# ── Android TWA (Play Store build) ──────────────────────────────────────
# Required for /.well-known/assetlinks.json to verify. Without it Chrome
# shows the URL bar inside the installed app. Include BOTH the upload key
# and the Play App Signing key fingerprint. See config/twa.php.
TWA_PACKAGE_NAME=com.sheltrify.app
TWA_SHA256_FINGERPRINTS=

# ── Legal pages (/privacy, /terms, /account-deletion) ───────────────────
# Google Play rejects listings whose privacy-policy or contact addresses
# bounce, so these must be mailboxes somebody actually reads.
LEGAL_COMPANY_NAME="Sheltrify Company Limited"
LEGAL_CONTACT_EMAIL=support@sheltrify.com
LEGAL_PRIVACY_EMAIL=privacy@sheltrify.com
LEGAL_ADMIN_EMAIL=support@sheltrify.com
LEGAL_ADDRESS="Lagos, Nigeria"
LEGAL_EFFECTIVE_DATE="30 August 2026"
