# ── PHP limits (shared hosting defaults are too low for mobile photo uploads) ──
<IfModule mod_php.c>
    php_value upload_max_filesize 15M
    php_value post_max_size       18M
    php_value memory_limit        256M
    php_value max_execution_time  120
</IfModule>
# cPanel often uses php8x handler instead of mod_php
<IfModule mod_php8.c>
    php_value upload_max_filesize 15M
    php_value post_max_size       18M
    php_value memory_limit        256M
    php_value max_execution_time  120
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # If the requested file exists inside public/, serve it directly (CSS, JS, images, etc.)
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f
    RewriteRule ^ public%{REQUEST_URI} [L]

    # Everything else goes through Laravel's front controller
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ public/index.php [L]
</IfModule>
